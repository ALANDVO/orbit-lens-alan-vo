# Orbit Lens Environment Configuration
# Copy to .env and fill in values

# Application
APP_NAME=orbit-lens
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./orbit_lens.db

# Security
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-base64-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OIDC/Keycloak
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/orbit-lens
OIDC_CLIENT_ID=orbit-lens
OIDC_CLIENT_SECRET=your-client-secret-from-keycloak
OIDC_REDIRECT_URI=http://127.0.0.1:3000/callback
OIDC_SCOPES=openid profile email roles

# LLM Providers (optional)
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=

# Demo Mode (local only - never enable in production)
DEMO_MODE=false