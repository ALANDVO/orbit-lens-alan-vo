{
  "realm": "orbit-lens",
  "enabled": true,
  "displayName": "Orbit Lens",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "orbit-lens",
      "name": "Orbit Lens Frontend",
      "description": "Orbit Lens SPA client for PKCE authentication",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "orbit-lens-secret-change-in-production",
      "redirectUris": [
        "http://127.0.0.1:3000/callback",
        "http://localhost:3000/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:3000",
        "http://localhost:3000"
      ],
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "1800",
        "client.secret.creation.time": "1700000000"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Read-only access to audit runs and findings"
      },
      {
        "name": "analyst",
        "description": "Can create and manage audit runs"
      },
      {
        "name": "admin",
        "description": "Full administrative access"
      }
    ],
    "client": {}
  },
  "groups": [],
  "users": [
    {
      "username": "admin",
      "email": "admin@example.com",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    },
    {
      "username": "analyst",
      "email": "analyst@example.com",
      "firstName": "Analyst",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "analyst",
          "temporary": false
        }
      ],
      "realmRoles": ["analyst"]
    },
    {
      "username": "viewer",
      "email": "viewer@example.com",
      "firstName": "Viewer",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "viewer",
          "temporary": false
        }
      ],
      "realmRoles": ["viewer"]
    }
  ],
  "clientScopes": [
    {
      "name": "roles",
      "description": "User roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ]
}